CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_xr30=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_cmcc_xr30=""
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=448
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_dnsmasq=y
# Merge with the pinned official config using xr30-official-abi.py seed.
# Compile optional modules for ABI compatibility; install them later from feeds.
CONFIG_PACKAGE_kmod-tun=m
CONFIG_PACKAGE_kmod-inet-diag=m
CONFIG_PACKAGE_kmod-nft-tproxy=m
CONFIG_IMAGEOPT=y
CONFIG_PREINITOPT=y
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y
CONFIG_TARGET_PREINIT_IP="192.168.10.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.10.255"
CONFIG_VERSIONOPT=y
CONFIG_VERSION_NUMBER="25.12.5-XR30"
CONFIG_VERSION_FILENAMES=y
CONFIG_VERSION_REPO="https://downloads.openwrt.org/releases/25.12.5"
# Disable distribution archives, not the underlying toolchains.
# CONFIG_IB is not set
# CONFIG_SDK is not set
# CONFIG_SDK_LLVM_BPF is not set
# CONFIG_MAKE_TOOLCHAIN is not set
