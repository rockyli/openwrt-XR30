#!/bin/sh
. /lib/functions.sh

# Retained installations keep their UCI files. Resolve existing DHCPv6 clients
# after netifd starts; an absent modem or a dynamic interface is normal at boot.
if uci -q get network.cellular >/dev/null; then
	uci -q get network.cellular6 >/dev/null || touch /etc/xr30-cellular6-auto
	exit $?
fi

find_wan_zone() {
	local name
	config_get name "$1" name
	[ "$name" = wan ] && wan_zone=$1
}

wan_zone=
config_load firewall
config_foreach find_wan_zone zone
[ -n "$wan_zone" ] || exit 1

case " $(uci -q get "firewall.$wan_zone.network") " in
	*" cellular "*) ;;
	*) uci add_list "firewall.$wan_zone.network=cellular" || exit 1 ;;
esac
uci batch <<'UCI' || exit 1
set network.cellular=interface
set network.cellular.device='cell0'
set network.cellular.proto='dhcp'
set network.cellular.metric='100'
set network.cellular.peerdns='1'
UCI

/usr/libexec/xr30-cellular6 factory
