#!/bin/sh
# Identify the USB function even when attached through a hub.
netdev=$1
[ -e "$netdev/device" ] || exit 0
name=${netdev##*/}
driver=$(readlink "$netdev/device/driver") || exit 0
case "${driver##*/}" in cdc_ether|rndis_host) ;; *) exit 0 ;; esac
read -r vendor < "$netdev/device/../idVendor" || exit 0
read -r product < "$netdev/device/../idProduct" || exit 0
case "$vendor:$product:${driver##*/}" in
	2ecc:3012:cdc_ether) ;;
	18d1:d001:rndis_host)
		IFS= read -r label < "$netdev/device/../product" || exit 0
		[ "$label" = 'HandsomeMod Device' ] || exit 0
		;;
	*) exit 0 ;;
esac

# Retained installations may still bind cellular to the original name.
target=$(uci -q get network.cellular.device) || exit 0
case "$target" in cell0|ml307r0) ;; *) exit 0 ;; esac
[ "$name" != "$target" ] && [ ! -e "${netdev%/*}/$target" ] || exit 0
ip link set dev "$name" name "$target"
