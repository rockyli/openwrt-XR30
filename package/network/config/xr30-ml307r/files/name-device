#!/bin/sh
# Name only the tested ML307R USB function, irrespective of port or ethN order.
netdev=$1
[ -e "$netdev/device" ] || exit 0
name=${netdev##*/}
[ "$name" != ml307r0 ] || exit 0
driver=$(readlink "$netdev/device/driver") || exit 0
[ "${driver##*/}" = cdc_ether ] || exit 0
read -r vendor < "$netdev/device/../idVendor" || exit 0
read -r product < "$netdev/device/../idProduct" || exit 0
[ "$vendor:$product" = 2ecc:3012 ] || exit 0
[ "$(uci -q get network.cellular.device)" = ml307r0 ] || exit 0

ip link set dev "$name" name ml307r0
