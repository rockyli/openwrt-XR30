#!/bin/sh
# Identify the USB function even when attached through a hub.
matches_modem() {
	local path="$1/device" driver vendor product label
	driver=$(readlink "$path/driver") || return 1
	case "${driver##*/}" in cdc_ether|rndis_host) ;; *) return 1 ;; esac
	read -r vendor < "$path/../idVendor" || return 1
	read -r product < "$path/../idProduct" || return 1
	case "$vendor:$product:${driver##*/}" in
		2ecc:3012:cdc_ether) return 0 ;;
		18d1:d001:rndis_host)
			IFS= read -r label < "$path/../product" && [ "$label" = 'HandsomeMod Device' ] ;;
		*) return 1 ;;
	esac
}

if [ "$1" = --matches ]; then
	matches_modem "$2"
	exit $?
fi
netdev=$1
matches_modem "$netdev" || exit 0
name=${netdev##*/}

# Retained installations may still bind cellular to the original name.
target=$(uci -q get network.cellular.device) || exit 0
case "$target" in cell0|ml307r0) ;; *) exit 0 ;; esac
[ "$name" != "$target" ] && [ ! -e "${netdev%/*}/$target" ] || exit 0
ip link set dev "$name" name "$target"
